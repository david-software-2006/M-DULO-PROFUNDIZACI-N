@model CRUD.Models.Product;

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h2>¿Estás seguro de que deseas eliminar este producto?</h2>

<div>
    <h3>@Model.Name</h3>
    <p>Price: @Model.Price</p>
    <p>Category: @Model.Category</p>
    <p>Description: @Model.Description</p>
</div>

<form asp-action="ConfirmarEliminar" method="post">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Products")" class="btn btn-secondary">Cancel</a>
</form>
