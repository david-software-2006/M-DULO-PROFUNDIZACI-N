@model IEnumerable<CRUD.Models.Product>

@{
    ViewData["Title"] = "Lista de productos";
}

<h2>Lista de productos</h2>

<form method="get" action="/Home/BuscarProducto" class="mt-3">
    <div class="input-group mb-3">
        <input type="text" name="query" class="form-control" placeholder="Buscar producto" />
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

<div class="booton-1">
    <a href="/Home/CrearProducto" class="btn btn-success">Agregar producto</a>
</div>

<table class="table table-dark mt-3">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Description</th>
            <th>Functions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var producto in Model)
        {
            <tr>
                <td>@producto.Name</td>
                <td>@producto.Price</td>
                <td>@producto.Category</td>
                <td>@producto.Description</td>
                <td>
                    <a href="@Url.Action("ActualizarProducto", "Home", new { id = producto.Id })" class="btn btn-warning">Edit</a>
                    <a href="@Url.Action("EliminarProducto", "Home", new { id = producto.Id })" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>


